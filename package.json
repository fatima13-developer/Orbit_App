{
  "name": "orbit-social-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade MERN Social Media Web Application - Orbit",
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm install && npm run install:server && npm run install:client",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "test:server": "npm --prefix server test"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react-router-dom": "^7.18.4"
  }
}
