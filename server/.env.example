# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or local URI). If left unset or unreachable, in-memory MongoDB will auto-boot for local dev.
MONGODB_URI=mongodb://localhost:27017/orbit

# JWT Secrets
JWT_ACCESS_SECRET=orbit_super_secret_access_jwt_key_2026_production
JWT_REFRESH_SECRET=orbit_super_secret_refresh_jwt_key_2026_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Configuration (Optional - local fallback storage automatically active if not provided)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
